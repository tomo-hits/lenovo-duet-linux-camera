index 0000000..d63eb1c
--- /dev/null
+++ b/include/libcamera/internal/software_isp/focus_stats.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace libcamera {
+/* Same-colour horizontal second difference, before ISP tone/WB.
+ * Interior samples only: all neighbours are within the supplied row.
+ * 4x4 region sums are additive across independent worker buffers.
+ */
+template<typename Pixel, typename Regions>
+void accumulateFocus(const Pixel *row, unsigned int width, unsigned int y,
+                     unsigned int height, unsigned int bits, Regions &regions)
+{
+    if (width < 8 || !height || y >= height || bits < 8 || bits > 16)
+        return;
+    unsigned int gridY = std::min(3U, y * 4 / height);
+    for (unsigned int x = 2; x + 3 < width; x += 4) {
+        int64_t g = static_cast<int64_t>(row[x + 1]);
+        int64_t d = static_cast<int64_t>(row[x - 1]) - 2 * g + row[x + 3];
+        g *= 1U << (16 - bits);
+        d *= 1U << (16 - bits);
+        auto &r = regions[gridY * 4 + std::min(3U, x * 4 / width)];
+        r.energy += static_cast<uint64_t>(d * d);
+        r.green += static_cast<uint64_t>(g);
+        ++r.count;
+    }
+}
+
+template<typename Region>
+double focusContrast(const Region &r, unsigned int black16, double minSignal16 = 0)
+{
+    if (!r.count)
+        return 0;
+    uint64_t black = uint64_t(black16) * r.count;
+    if (r.green <= black || double(r.green - black) < minSignal16 * r.count)
+        return 0;
+    double sum = static_cast<double>(std::max<uint64_t>(r.count,
+                       r.green > black ? r.green - black : 0));
+    return 1000000.0 * double(r.energy) * r.count / (sum * sum);
+}
+} /* namespace libcamera */
diff --git a/src/ipa/libipa/agc_flicker.h b/src/ipa/libipa/agc_flicker.h
new file mode 100644
index 0000000..3109ed9
--- /dev/null
+++ b/src/ipa/libipa/agc_flicker.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace libcamera::ipa::agc {
+/* Apply an explicitly requested mains period to automatic exposure only.
+ * Keep the shared AGC's EV by adjusting automatic gain within its limits.
+ * Round each whole-period exposure to the nearest actual sensor line.
+ */
+inline void quantizeFlicker(uint32_t &exposure, double &gain,
+                           double lineUs, uint32_t periodUs,
+                           uint32_t minExposure, uint32_t maxExposure,
+                           double minGain, double maxGain, bool autoGain)
+{
+    if (!periodUs || !std::isfinite(lineUs) || lineUs <= 0 ||
+        !exposure || minExposure > maxExposure ||
+        !std::isfinite(gain) || gain <= 0 ||
+        !std::isfinite(minGain) || !std::isfinite(maxGain) ||
+        minGain <= 0 || minGain > maxGain)
+        return;
+    double periods = std::floor(exposure * lineUs / periodUs);
+    if (periods < 1)
+        return;
+    auto linesFor = [&](double n) {
+        return std::round(n * periodUs / lineUs);
+    };
+    double lines = linesFor(periods);
+    if (lines < minExposure || lines > maxExposure || lines < 1)
+        return;
+    double ev = double(exposure) * gain;
+    if (autoGain && ev / lines > maxGain) {
+        double higher = linesFor(periods + 1);
+        if (higher >= minExposure && higher <= maxExposure)
+            lines = higher;
+    }
+    exposure = static_cast<uint32_t>(lines);
+    if (autoGain)
+        gain = std::clamp(ev / lines, minGain, maxGain);
+}
+} /* namespace libcamera::ipa::agc */
diff --git a/src/ipa/softisp/algorithms/af.cpp b/src/ipa/softisp/algorithms/af.cpp
new file mode 100644
index 0000000..855e976
--- /dev/null
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* SoftISP adapter to the existing BSD-2-Clause RPiController AF engine.
+ * It consumes CPU contrast statistics; no PDAF data are fabricated.
+ */
+#include "af.h"
+#include <algorithm>
+#include <cmath>
+#include <numeric>
+#include <linux/videodev2.h>
+#include <libcamera/base/log.h>
+#include <libcamera/control_ids.h>
+#include "libcamera/internal/software_isp/focus_stats.h"
+
+namespace libcamera {
+LOG_DEFINE_CATEGORY(IPASoftIspAf)
+namespace ipa::softisp::algorithms {
+using Backend = RPiController::AfAlgorithm;
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+    auto lens = context.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+    if (lens == context.lensControls.end())
+        return 0;
+    minSignal16_ = tuningData["contrast_min_signal"].get<double>(0.0);
+    if (!std::isfinite(minSignal16_) || minSignal16_ < 0 || minSignal16_ > 65535)
+        return -EINVAL;
+    min_ = lens->second.min().get<int32_t>();
+    max_ = lens->second.max().get<int32_t>();
+    /* A module-specific map is essential: upstream defaults are IMX708. */
+    if (!tuningData.contains("map") || min_ >= max_)
+        return -EINVAL;
+    std::vector<double> map;
+    for (const auto &entry : tuningData["map"].asList()) {
+        auto value = entry.get<double>();
+        if (!value || !std::isfinite(*value))
+            return -EINVAL;
+        map.push_back(*value);
+    }
+    if (map.size() < 4 || map.size() % 2)
+        return -EINVAL;
+    for (unsigned int i = 0; i < map.size(); i += 2) {
+        if ((i && map[i] <= map[i - 2]) || map[i + 1] < min_ || map[i + 1] > max_)
+            return -EINVAL;
+    }
+    af_ = std::make_unique<RPiController::Af>(nullptr);
+    int ret = af_->read(tuningData);
+    if (ret)
+        return ret;
+    af_->initialise();
+    double lo, hi;
+    af_->getLensLimits(lo, hi);
+    if (!std::isfinite(lo) || !std::isfinite(hi) || lo > hi)
+        return -EINVAL;
+    context.ctrlMap[&controls::AfMode] = ControlInfo(controls::AfModeValues, controls::AfModeContinuous);
+    context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+    context.ctrlMap[&controls::AfRange] = ControlInfo(controls::AfRangeValues);
+    context.ctrlMap[&controls::AfSpeed] = ControlInfo(controls::AfSpeedValues);
+    context.ctrlMap[&controls::AfPause] = ControlInfo(controls::AfPauseValues);
+    mapCalibrated_ = tuningData["mapCalibrated"].get<bool>(false);
+    if (mapCalibrated_)
+        context.ctrlMap[&controls::LensPosition] = ControlInfo(float(lo), float(hi),
+                                                 float(af_->getDefaultLensPosition()));
+    return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+    if (!af_)
+        return 0;
+    if (!configInfo.focusStats)
+        return -EOPNOTSUPP;
+    context.activeState.lensSetting.reset();
+    status_ = {};
+    CameraMode mode{};
+    mode.width = configInfo.sensorInfo.outputSize.width;
+    mode.height = configInfo.sensorInfo.outputSize.height;
+    mode.scaleX = mode.scaleY = 1.0;
+    RPiController::Metadata m;
+    af_->setMode(Backend::AfModeManual);
+    af_->pause(Backend::AfPauseResume);
+    af_->switchMode(mode, &m);
+    /* Continuous is the tuning default for applications which omit AfMode. */
+    af_->setMode(Backend::AfModeContinuous);
+    return 0;
+}
+
+void Af::queueRequest(IPAContext &context, [[maybe_unused]] uint32_t frame,
+                     [[maybe_unused]] IPAFrameContext &frameContext,
+                     const ControlList &ctrls)
+{
+    if (!af_)
+        return;
+    if (auto mode = ctrls.get(controls::AfMode))
+        af_->setMode(static_cast<Backend::AfMode>(*mode));
+    if (auto range = ctrls.get(controls::AfRange))
+        af_->setRange(static_cast<Backend::AfRange>(*range));
+    if (auto speed = ctrls.get(controls::AfSpeed))
+        af_->setSpeed(static_cast<Backend::AfSpeed>(*speed));
+    if (auto pause = ctrls.get(controls::AfPause))
+        af_->pause(static_cast<Backend::AfPause>(*pause));
+    if (auto lens = ctrls.get(controls::LensPosition); lens && mapCalibrated_) {
+        int32_t hwpos;
+        if (af_->setLensPosition(*lens, &hwpos, false))
+            context.activeState.lensSetting = std::clamp(hwpos, min_, max_);
+    }
+    if (auto trigger = ctrls.get(controls::AfTrigger)) {
+        if (*trigger == controls::AfTriggerStart)
+            af_->triggerScan();
+        else
+            af_->cancelScan();
+    }
+}
+
+void Af::process(IPAContext &context, [[maybe_unused]] uint32_t frame,
+                [[maybe_unused]] IPAFrameContext &frameContext,
+                const SwIspStats *stats, ControlList &metadata)
+{
+    if (!af_)
+        return;
+    if (context.activeState.lensError) {
+        af_->cancelScan();
+        context.activeState.lensSetting.reset();
+        metadata.set(controls::AfState, controls::AfStateFailed);
+        return;
+    }
+    if (stats->valid) {
+        using Stats = RPiController::Statistics;
+        auto input = std::make_shared<Stats>(Stats::AgcStatsPos::PreWb,
+                                            Stats::ColourStatsPos::PreLsc);
+        input->focusRegions.init(Size(SwIspStats::kFocusCols, SwIspStats::kFocusRows));
+        for (unsigned int i = 0; i < stats->focus.size(); ++i) {
+            double contrast = focusContrast(stats->focus[i],
+                                          context.activeState.blc.level * 256U, minSignal16_);
+            input->focusRegions.set(i, { uint64_t(std::clamp(contrast, 0.0, double(UINT32_MAX))), stats->focus[i].count, 0 });
+        }
+        uint64_t n = std::accumulate(stats->yHistogram.begin(),
+                                    stats->yHistogram.end(), uint64_t(0));
+        input->awbRegions.init(Size(1, 1));
+        input->awbRegions.set(0, { { stats->sum_.r() / std::max(n, uint64_t(1)),
+                                    stats->sum_.g() / std::max(n, uint64_t(1)),
+                                    stats->sum_.b() / std::max(n, uint64_t(1)), 0 },
+                                   uint32_t(n), 0 });
+        RPiController::Metadata m;
+        af_->process(input, &m);
+        af_->prepare(&m);
+        m.get("af.status", status_);
+        if (status_.lensSetting)
+            context.activeState.lensSetting = std::clamp(*status_.lensSetting, min_, max_);
+        LOG(IPASoftIspAf, Debug) << "frame=" << frame << " state=" << int(status_.state)
+                               << " lens=" << context.activeState.lensSetting.value_or(-1);
+    }
+    metadata.set(controls::AfState, static_cast<int32_t>(status_.state));
+    metadata.set(controls::AfPauseState, static_cast<int32_t>(status_.pauseState));
+    /* Do not label the next actuator command as this image's position.
+     * Optical settling/frame alignment and physical map calibration remain
+     * necessary before reporting LensPosition metadata. */
+}
+REGISTER_IPA_ALGORITHM(Af, "Af")
+} /* namespace ipa::softisp::algorithms */
+} /* namespace libcamera */
diff --git a/src/ipa/softisp/algorithms/af.h b/src/ipa/softisp/algorithms/af.h
new file mode 100644
index 0000000..caeca0d
